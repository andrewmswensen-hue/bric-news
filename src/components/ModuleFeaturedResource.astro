---
import { getCollection } from 'astro:content';
import ResourceCard from './ResourceCard.astro';

const all = await getCollection('resources');
const sorted = all.sort((a, b) => a.data.label.localeCompare(b.data.label));

function isoWeek(d = new Date()) {
  const date = new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));
  const dayNum = date.getUTCDay() || 7;
  date.setUTCDate(date.getUTCDate() + 4 - dayNum);
  const yearStart = new Date(Date.UTC(date.getUTCFullYear(), 0, 1));
  return Math.ceil(((+date - +yearStart) / 86400000 + 1) / 7);
}
const featured = sorted[isoWeek() % sorted.length];
---

<section class="module-band bg-bone-2">
  <div class="container-content">
    <div class="mb-2">
      <h2 class="module-heading">Resource of the Week</h2>
      <p class="module-sub">One Columbus investor resource worth bookmarking this week.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      <div class="md:col-span-2">
        {featured && <ResourceCard resource={featured} wide />}
      </div>
    </div>

    <p class="mt-6 text-right">
      <a href="/resources" class="link-arrow">Browse all resources →</a>
    </p>
  </div>
</section>
