---
const year = new Date().getFullYear();
---

<footer class="border-t border-rule bg-bone mt-16">
  <div class="container-content py-12 grid grid-cols-1 md:grid-cols-3 gap-8">
    <div>
      <a href="/" class="inline-block no-underline" aria-label="BRIC.News home">
        <img src="/logos/bric-logo-color.svg" alt="BRIC" class="h-8 w-auto" />
      </a>
      <p class="mt-3 text-slate text-sm italic">Buy. Rent. Invest. Columbus.</p>
      <p class="mt-1 text-slate text-xs">Columbus investor news, business directory, and resources. Updated daily.</p>
    </div>

    <div>
      <h4 class="font-heading font-bold text-charcoal text-sm uppercase tracking-wider mb-3">Browse</h4>
      <ul class="space-y-2 text-sm">
        <li><a href="/policy" class="text-charcoal hover:text-brick no-underline">Policy</a></li>
        <li><a href="/news" class="text-charcoal hover:text-brick no-underline">News</a></li>
        <li><a href="/business-directory" class="text-charcoal hover:text-brick no-underline">Business Directory</a></li>
        <li><a href="/resources" class="text-charcoal hover:text-brick no-underline">Resources</a></li>
        <li><a href="/guides" class="text-charcoal hover:text-brick no-underline">Guides</a></li>
        <li><a href="/about" class="text-charcoal hover:text-brick no-underline">About</a></li>
      </ul>
    </div>

    <div>
      <h4 class="font-heading font-bold text-charcoal text-sm uppercase tracking-wider mb-3">Elsewhere</h4>
      <ul class="space-y-2 text-sm">
        <li><a href="mailto:hello@bric.news" class="text-charcoal hover:text-brick no-underline">Contact</a></li>
        <li><a href="mailto:hello@bric.news?subject=Business%20submission" class="text-charcoal hover:text-brick no-underline">Submit a business</a></li>
        <li><a href="/about#corrections" class="text-charcoal hover:text-brick no-underline">Correction policy</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-rule">
    <div class="container-content py-5 text-xs text-slate">
      © {year} BRIC.News
    </div>
  </div>
</footer>
