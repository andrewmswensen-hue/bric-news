---
import type { CollectionEntry } from 'astro:content';
import { itemPayload } from '../lib/itemPayload';

interface Props {
  item: CollectionEntry<'items'>;
  showPolicyBadge?: boolean;
}

const { item, showPolicyBadge = false } = Astro.props;
const p = itemPayload(item);

const truncated = p.summary.length > 240 ? p.summary.slice(0, 237).trimEnd() + '…' : p.summary;
const faviconSrc = `https://www.google.com/s2/favicons?domain=${p.sourceDomain}&sz=32`;
const showScope = p.scope !== 'local';
---

<article
  class="relative bg-bone-2 border border-rule p-5 h-full flex flex-col"
  data-item-card
  data-slug={p.slug}
  data-item={JSON.stringify(p)}
>
  <div class="absolute top-4 right-4 flex items-center gap-1.5">
    {showPolicyBadge && <span class="badge-policy">Policy</span>}
    {showScope && <span class="chip-scope">{p.scopeLabel}</span>}
    {p.partner && <span class="chip-partner">Partner</span>}
  </div>

  <div class="flex flex-wrap items-center gap-2 text-xs text-slate mb-3 pr-24">
    <img
      src={faviconSrc}
      alt=""
      width="14"
      height="14"
      class="rounded-sm flex-shrink-0"
      loading="lazy"
      onerror="this.style.display='none'"
    />
    <span class="uppercase tracking-wider">{p.partner ? p.partner.name : p.sourceName}</span>
    <span aria-hidden="true">·</span>
    <span>{p.dateLabel}</span>
  </div>

  <h3 class="font-heading font-bold text-lg leading-snug mb-2">
    <a href={`#item=${p.slug}`} aria-haspopup="dialog" class="text-charcoal hover:text-brick no-underline">
      {p.title}
    </a>
  </h3>

  <p class="text-sm text-charcoal leading-relaxed mb-3">{truncated}</p>

  {p.why && (
    <p class="text-sm text-slate italic border-l-2 border-brick pl-3 mb-4">
      <span class="not-italic font-medium text-brick uppercase tracking-wider text-xs mr-1">Why it matters:</span>
      {p.why}
    </p>
  )}

  <div class="mt-auto pt-2 flex flex-wrap items-center justify-between gap-3">
    <div class="flex flex-wrap gap-1.5">
      {p.topics.slice(0, 3).map((t) => <span class="chip">{t}</span>)}
      {p.municipalities.slice(0, 2).map((m) => <span class="chip">{m.replace(/-/g, ' ')}</span>)}
    </div>
    <span class="read-more" aria-hidden="true">Read more →</span>
  </div>
</article>
