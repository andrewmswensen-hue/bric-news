---
import type { CollectionEntry } from 'astro:content';

interface Props {
  item: CollectionEntry<'items'>;
  showPolicyBadge?: boolean;
}

const { item, showPolicyBadge = false } = Astro.props;
const d = item.data;

const dateStr = d.published_at.toLocaleDateString('en-US', {
  month: 'short', day: 'numeric', year: 'numeric',
});

const truncated = d.summary.length > 240 ? d.summary.slice(0, 237).trimEnd() + '…' : d.summary;
---

<article class="relative bg-bone-2 border border-rule p-5 h-full flex flex-col">
  {showPolicyBadge && (
    <span class="badge-policy absolute top-4 right-4">POLICY</span>
  )}

  <div class="flex flex-wrap items-center gap-2 text-xs text-slate mb-3 pr-16">
    <span class="uppercase tracking-wider">{d.source_domain}</span>
    <span aria-hidden="true">·</span>
    <span>{dateStr}</span>
  </div>

  <h3 class="font-heading font-bold text-lg leading-snug mb-2">
    <a href={d.source_url} target="_blank" rel="noopener noreferrer" class="text-charcoal hover:text-brick no-underline">
      {d.title}
    </a>
  </h3>

  <p class="text-sm text-charcoal leading-relaxed mb-3">{truncated}</p>

  {d.why_it_matters && (
    <p class="text-sm text-slate italic border-l-2 border-brick pl-3 mb-4">
      <span class="not-italic font-medium text-brick uppercase tracking-wider text-xs mr-1">Why it matters:</span>
      {d.why_it_matters}
    </p>
  )}

  <div class="mt-auto flex flex-wrap gap-1.5 pt-2">
    {d.topics.slice(0, 3).map(t => <span class="chip">{t}</span>)}
    {d.municipalities.slice(0, 2).map(m => <span class="chip">{m.replace('-', ' ')}</span>)}
  </div>
</article>
