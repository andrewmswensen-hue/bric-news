---
/**
 * Columbus-by-the-numbers strip — one stat per letter of BRIC.
 * Values are placeholders; swap to live data by wiring to a small content
 * collection later or by editing this file when new market-data items land.
 *
 *   B — Buy:    median SFR sale price (Columbus REALTORS, monthly)
 *   R — Rent:   median asking rent, all rental property types (Realtor.com)
 *   I — Invest: home price index, year-over-year (FHFA HPI, quarterly)
 *   C — Columbus: overall rental vacancy rate (U.S. Census Housing Vacancy Survey)
 */
const stats = [
  {
    letter: 'B',
    label: 'Buy',
    value: '$342K',
    caption: 'Median home sale price',
    source: 'Columbus REALTORS',
    href: 'https://www.columbusrealtors.com/market-stats/',
  },
  {
    letter: 'R',
    label: 'Rent',
    value: '$1,545',
    caption: 'Median asking rent',
    source: 'Realtor.com, all rentals',
    href: 'https://www.realtor.com/research/data/',
  },
  {
    letter: 'I',
    label: 'Invest',
    value: '+3.8%',
    caption: 'Home price, year over year',
    source: 'FHFA HPI',
    href: 'https://www.fhfa.gov/DataTools/Downloads/Pages/House-Price-Index.aspx',
  },
  {
    letter: 'C',
    label: 'Columbus',
    value: '6.8%',
    caption: 'Rental vacancy rate',
    source: 'U.S. Census HVS',
    href: 'https://www.census.gov/housing/hvs/',
  },
];
---

<section class="bg-brick text-bone">
  <div class="container-content py-10 md:py-12">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 md:gap-10">
      {stats.map((s) => (
        <a
          href={s.href}
          target="_blank"
          rel="noopener noreferrer"
          class="block no-underline group text-bone"
        >
          <div class="flex items-baseline gap-2 mb-1">
            <span class="font-heading font-extrabold text-bone text-sm uppercase tracking-widest">{s.letter}</span>
            <span class="text-bone/70 text-xs uppercase tracking-wider">{s.label}</span>
          </div>
          <div class="font-heading font-extrabold text-bone text-3xl md:text-4xl tracking-tight leading-none mb-2 group-hover:underline decoration-bone underline-offset-4">
            {s.value}
          </div>
          <div class="text-bone text-sm font-medium">{s.caption}</div>
          <div class="text-bone/60 text-xs mt-1">{s.source} ↗</div>
        </a>
      ))}
    </div>
  </div>
</section>
