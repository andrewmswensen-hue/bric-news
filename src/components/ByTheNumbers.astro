---
/**
 * Columbus-by-the-numbers strip. Three big stats above-the-fold-ish on the homepage.
 * Numbers update by editing this file (or wire to a content collection later).
 * Source items live in src/content/items/ — keep these aligned with the most recent
 * market_data items so the strip and feed stay consistent.
 */
const stats = [
  {
    value: '$1,287',
    label: 'Median rent (Apr 2026)',
    sub: 'Apartment List, Columbus MSA',
    href: '/news',
  },
  {
    value: '7.1%',
    label: 'Multifamily vacancy',
    sub: 'CoStar, Columbus MSA',
    href: '/news',
  },
  {
    value: '+3.8%',
    label: 'Home price index, YoY',
    sub: 'FHFA, Q1 2026',
    href: '/news',
  },
];
---

<section class="bg-bone-2 border-y border-rule">
  <div class="container-content py-8 md:py-10">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 md:gap-10 text-center sm:text-left">
      {stats.map((s) => (
        <a href={s.href} class="block no-underline group">
          <div class="font-heading font-extrabold text-brick text-3xl md:text-4xl lg:text-5xl tracking-tight leading-none mb-2 group-hover:opacity-90">
            {s.value}
          </div>
          <div class="font-heading font-bold text-charcoal text-sm uppercase tracking-wider">{s.label}</div>
          <div class="text-slate text-xs mt-1">{s.sub}</div>
        </a>
      ))}
    </div>
  </div>
</section>
