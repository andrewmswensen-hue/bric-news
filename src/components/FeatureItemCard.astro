---
import type { CollectionEntry } from 'astro:content';
import { itemPayload } from '../lib/itemPayload';

interface Props {
  item: CollectionEntry<'items'>;
  showPolicyBadge?: boolean;
}

const { item, showPolicyBadge = false } = Astro.props;
const p = itemPayload(item);

const dateLong = item.data.published_at.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

// First sentence as pull quote (truncated if long).
const firstSentence = p.summary.split(/(?<=[.!?])\s+/)[0] || p.summary;
const pullQuote = firstSentence.length > 200 ? firstSentence.slice(0, 197).trimEnd() + '…' : firstSentence;

const faviconSrc = `https://www.google.com/s2/favicons?domain=${p.sourceDomain}&sz=32`;
const showScope = p.scope !== 'local';
---

<article
  class="relative bg-bone-2 border border-rule overflow-hidden grid grid-cols-1 md:grid-cols-3 gap-0 md:gap-6"
  data-item-card
  data-slug={p.slug}
  data-item={JSON.stringify(p)}
>
  <div class="absolute top-4 right-4 z-10 flex items-center gap-1.5">
    {showPolicyBadge && <span class="badge-policy">Policy</span>}
    {showScope && <span class="chip-scope">{p.scopeLabel}</span>}
    {p.partner && <span class="chip-partner">Partner</span>}
  </div>

  <div class="md:col-span-2 p-6 md:p-8 flex flex-col">
    <div class="flex items-center gap-2 text-xs text-slate mb-4 pr-28">
      <img
        src={faviconSrc}
        alt=""
        width="16"
        height="16"
        class="rounded-sm flex-shrink-0"
        loading="lazy"
        onerror="this.style.display='none'"
      />
      <span class="uppercase tracking-wider">{p.partner ? p.partner.name : p.sourceName}</span>
      <span aria-hidden="true">·</span>
      <span>{dateLong}</span>
    </div>

    <h2 class="font-heading font-extrabold text-charcoal text-2xl md:text-3xl leading-tight mb-4">
      <a href={`#item=${p.slug}`} aria-haspopup="dialog" class="text-charcoal hover:text-brick no-underline">
        {p.title}
      </a>
    </h2>

    <p class="text-base text-charcoal leading-relaxed mb-5">{p.summary}</p>

    {p.why && (
      <p class="text-base text-slate italic border-l-4 border-brick pl-4 mb-5">
        <span class="not-italic font-semibold text-brick uppercase tracking-wider text-xs mr-1">Why it matters:</span>
        {p.why}
      </p>
    )}

    <div class="mt-auto flex flex-wrap items-center gap-3">
      <span class="read-more text-sm" aria-hidden="true">Read the full item →</span>
      {!p.realSource && (
        <span class="text-xs italic text-slate">Source link pending</span>
      )}
    </div>
  </div>

  <div class="md:col-span-1 p-6 md:p-8 bg-bone border-t md:border-t-0 md:border-l border-rule flex flex-col justify-between">
    {pullQuote && (
      <blockquote class="font-heading font-bold text-brick text-lg md:text-xl leading-snug mb-6">
        "{pullQuote}"
      </blockquote>
    )}

    <div class="flex flex-wrap gap-1.5">
      {p.topics.slice(0, 4).map((t) => <span class="chip">{t}</span>)}
      {p.municipalities.slice(0, 3).map((m) => <span class="chip">{m.replace(/-/g, ' ')}</span>)}
    </div>
  </div>
</article>
