---
interface Props {
  category: 'government' | 'tax' | 'legal' | 'market-data' | 'events' | 'vendors' | string;
  class?: string;
}

const { category, class: className = '' } = Astro.props;
const base = 'w-5 h-5 flex-shrink-0 text-brick';
---

{category === 'government' && (
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={`${base} ${className}`}>
    <path d="M3 21h18"/>
    <path d="M5 21V10l7-5 7 5v11"/>
    <path d="M9 21v-6h6v6"/>
  </svg>
)}

{category === 'tax' && (
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={`${base} ${className}`}>
    <path d="M12 2v20"/>
    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
  </svg>
)}

{category === 'legal' && (
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={`${base} ${className}`}>
    <path d="M12 3v18"/>
    <path d="M9 21h6"/>
    <path d="M5 8h14"/>
    <path d="M5 8v2"/>
    <path d="M2 13a3 3 0 0 0 6 0"/>
    <path d="M19 8v2"/>
    <path d="M16 13a3 3 0 0 0 6 0"/>
  </svg>
)}

{category === 'market-data' && (
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={`${base} ${className}`}>
    <path d="M3 3v18h18"/>
    <path d="M7 16l4-4 3 3 6-6"/>
    <path d="M16 9h4v4"/>
  </svg>
)}

{category === 'events' && (
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={`${base} ${className}`}>
    <rect x="3" y="4" width="18" height="17" rx="2"/>
    <path d="M16 2v4"/>
    <path d="M8 2v4"/>
    <path d="M3 10h18"/>
    <path d="M8 14h.01"/>
    <path d="M12 14h.01"/>
    <path d="M16 14h.01"/>
  </svg>
)}

{category === 'vendors' && (
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={`${base} ${className}`}>
    <path d="M3 9l2-5h14l2 5"/>
    <path d="M4 9v11a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V9"/>
    <path d="M9 21v-6h6v6"/>
    <path d="M3 9a3 3 0 0 0 6 0 3 3 0 0 0 6 0 3 3 0 0 0 6 0"/>
  </svg>
)}
