---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import NewsletterCTA from './NewsletterCTA.astro';
import HeroStoryCard from './HeroStoryCard.astro';
import HeroGuideCard from './HeroGuideCard.astro';

interface Props {
  policyPick: CollectionEntry<'items'> | null;
  newsPick: CollectionEntry<'items'> | null;
}

// The two lead stories are chosen in src/lib/homepage.ts alongside every
// other band, so nothing on the page appears twice.
const { policyPick, newsPick } = Astro.props;

// Small slot 2: featured guide.
const guides = await getCollection('guides');
const guidePick = guides.sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return b.data.published_at.getTime() - a.data.published_at.getTime();
})[0];
---

<section class="bg-bone">
  <div class="container-content pt-14 md:pt-20 pb-14 md:pb-16">
    <div class="grid grid-cols-1 md:grid-cols-5 gap-10 md:gap-14 items-start">
      <!-- Left: branding + subscribe -->
      <div class="md:col-span-2 text-center md:text-left md:sticky md:top-8">
        <h1 class="sr-only">BRIC.News – Buy. Rent. Invest. Columbus.</h1>
        <img
          src="/logos/bric-logo-color-tagline.svg"
          alt="BRIC – Buy · Rent · Invest · Columbus"
          class="mx-auto md:mx-0 w-full max-w-[340px] md:max-w-[400px] h-auto"
        />
        <p class="mt-5 text-slate text-sm md:text-base">
          Columbus investor news, business directory, and resources. Updated daily.
        </p>
        <div class="mt-6 mx-auto md:mx-0 max-w-[360px]">
          <NewsletterCTA inline />
        </div>
      </div>

      <!-- Right: Top Stories asymmetric — 1 big policy + 2 small (news, guide) -->
      <div class="md:col-span-3">
        <div class="mb-4">
          <h2 class="font-heading font-bold text-brick text-sm uppercase tracking-widest">Top Stories</h2>
          <p class="text-xs text-slate mt-1">What Columbus investors need to see this week.</p>
        </div>

        <div class="grid grid-cols-1 gap-5">
          {policyPick && <HeroStoryCard item={policyPick} variant="policy" size="big" />}
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            {newsPick && <HeroStoryCard item={newsPick} variant="news" size="small" />}
            {guidePick && <HeroGuideCard guide={guidePick} />}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
