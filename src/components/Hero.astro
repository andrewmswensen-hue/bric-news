---
import NewsletterCTA from './NewsletterCTA.astro';
---

<section class="bg-bone">
  <div class="container-content pt-20 md:pt-28 pb-16 md:pb-20 text-center">
    <h1 class="sr-only">BRIC.News – Buy. Rent. Invest. Columbus.</h1>
    <img
      src="/logos/bric-logo-color-tagline.svg"
      alt="BRIC — Buy · Rent · Invest · Columbus"
      class="mx-auto w-full max-w-[520px] md:max-w-[640px] h-auto"
    />
    <p class="mt-4 text-slate text-sm md:text-base">Columbus investor news, vendors, and resources. Updated daily.</p>

    <div class="mt-8 mx-auto max-w-[400px]">
      <NewsletterCTA inline />
    </div>

    <p class="mt-6 text-sm">
      <a href="/vendors" class="link-arrow">Or browse the vendor directory →</a>
    </p>
  </div>
</section>
