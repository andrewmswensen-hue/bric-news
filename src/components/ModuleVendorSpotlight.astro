---
import { getCollection } from 'astro:content';
import VendorCard from './VendorCard.astro';

const all = await getCollection('vendors');
const sorted = all.sort((a, b) => a.data.name.localeCompare(b.data.name));

// Deterministic weekly rotation by ISO week number.
function isoWeek(d = new Date()) {
  const date = new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));
  const dayNum = date.getUTCDay() || 7;
  date.setUTCDate(date.getUTCDate() + 4 - dayNum);
  const yearStart = new Date(Date.UTC(date.getUTCFullYear(), 0, 1));
  return Math.ceil(((+date - +yearStart) / 86400000 + 1) / 7);
}
const week = isoWeek();
const count = sorted.length;
const pick = (offset: number) => sorted[(week + offset) % count];
const spotlight = count >= 3 ? [pick(0), pick(1), pick(2)] : sorted.slice(0, 3);
---

<section class="module-band bg-bone">
  <div class="container-content">
    <div class="mb-2">
      <h2 class="module-heading">Vendor Spotlight</h2>
      <p class="module-sub">Columbus-area vendors investors use to get work done.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {spotlight.map((v) => <VendorCard vendor={v} compact />)}
    </div>

    <p class="mt-6 text-right">
      <a href="/vendors" class="link-arrow">Browse full vendor directory →</a>
    </p>
  </div>
</section>
