---
import { getCollection } from 'astro:content';
import ItemCard from './ItemCard.astro';

const all = await getCollection('items');
const news = all
  .filter((i) => i.data.content_type !== 'policy')
  .sort((a, b) => b.data.published_at.getTime() - a.data.published_at.getTime())
  .slice(0, 3);
---

<section class="module-band bg-bone-2">
  <div class="container-content">
    <div class="mb-2">
      <h2 class="module-heading">Latest Columbus News</h2>
      <p class="module-sub">Market data, developments, and news for Columbus investors.</p>
    </div>

    {news.length === 0 ? (
      <p class="text-slate italic">No recent news items.</p>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {news.map((item) => <ItemCard item={item} />)}
      </div>
    )}

    <p class="mt-6 text-right">
      <a href="/news" class="link-arrow">See all news →</a>
    </p>
  </div>
</section>
