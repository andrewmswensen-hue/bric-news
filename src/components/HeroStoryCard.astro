---
import type { CollectionEntry } from 'astro:content';
import { itemPayload } from '../lib/itemPayload';

interface Props {
  item: CollectionEntry<'items'>;
  variant?: 'policy' | 'news';
  size?: 'small' | 'big';
}

const { item, variant, size = 'small' } = Astro.props;
const p = itemPayload(item);
const kind = variant ?? (p.contentType === 'policy' ? 'policy' : 'news');
const isBig = size === 'big';
const isPolicy = kind === 'policy';

const dateShort = item.data.published_at.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
const summary = isBig
  ? (p.summary.length > 260 ? p.summary.slice(0, 257).trimEnd() + '…' : p.summary)
  : (p.summary.length > 140 ? p.summary.slice(0, 137).trimEnd() + '…' : p.summary);

const faviconSrc = `https://www.google.com/s2/favicons?domain=${p.sourceDomain}&sz=32`;
const showScope = p.scope !== 'local';
---

<article
  class={`bg-bone-2 border border-rule flex flex-col h-full ${isBig ? 'p-6 md:p-7' : 'p-4'}`}
  data-item-card
  data-slug={p.slug}
  data-item={JSON.stringify(p)}
>
  <div class={`flex items-center gap-2 ${isBig ? 'mb-4' : 'mb-2'}`}>
    <span class={isPolicy ? 'badge-policy' : 'badge-news'}>{isPolicy ? 'Policy' : p.typeLabel}</span>
    {showScope && <span class="chip-scope">{p.scopeLabel}</span>}
    {p.partner && <span class="chip-partner">Partner</span>}
    {isBig && (
      <>
        <span class="text-xs text-slate">·</span>
        <img
          src={faviconSrc}
          alt=""
          width="12"
          height="12"
          class="rounded-sm flex-shrink-0"
          loading="lazy"
          onerror="this.style.display='none'"
        />
        <span class="text-xs text-slate uppercase tracking-wider">{p.partner ? p.partner.name : p.sourceName}</span>
      </>
    )}
    <span class={`text-xs text-slate ${isBig ? '' : 'ml-auto'}`}>
      {isBig ? '· ' : ''}{dateShort}
    </span>
  </div>

  <h3 class={`font-heading font-bold leading-snug mb-2 ${isBig ? 'text-xl md:text-2xl' : 'text-base'}`}>
    <a href={`#item=${p.slug}`} aria-haspopup="dialog" class="text-charcoal hover:text-brick no-underline">
      {p.title}
    </a>
  </h3>

  <p class={`text-charcoal leading-relaxed mb-3 ${isBig ? 'text-sm md:text-base' : 'text-xs'}`}>{summary}</p>

  <div class="mt-auto pt-2 flex items-center justify-between gap-3 text-xs">
    <a href={p.sectionHref} data-nav class="text-slate hover:text-brick no-underline">
      {isPolicy ? 'More policy →' : 'More news →'}
    </a>
    <span class="read-more" aria-hidden="true">Read more →</span>
  </div>
</article>
