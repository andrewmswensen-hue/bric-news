---
interface Props {
  /** Shortens per-guide seed for deterministic variation. */
  seed?: string;
  /** Visual scale — 'wide' for detail page, 'card' for index thumbnails. */
  size?: 'wide' | 'card';
}

const { seed = 'default', size = 'wide' } = Astro.props;

// Map seed string to deterministic offset for pattern variation
function seedToOffset(s: string): number {
  let h = 0;
  for (let i = 0; i < s.length; i++) h = ((h << 5) - h + s.charCodeAt(i)) | 0;
  return Math.abs(h) % 8;
}

const offset = seedToOffset(seed);
const aspect = size === 'wide' ? 'aspect-[3/1]' : 'aspect-[4/3]';
---

<div class={`${aspect} w-full relative overflow-hidden bg-bone-2 border-b border-rule`} aria-hidden="true">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 600 200"
    preserveAspectRatio="xMidYMid slice"
    class="absolute inset-0 w-full h-full"
  >
    <defs>
      <pattern id={`brick-${seed}`} x={offset * 4} y={offset * 2} width="60" height="40" patternUnits="userSpaceOnUse">
        <rect x="0"  y="0"  width="58" height="18" rx="3" fill="#972E28" opacity="0.12"/>
        <rect x="-30" y="20" width="58" height="18" rx="3" fill="#972E28" opacity="0.18"/>
        <rect x="30" y="20" width="58" height="18" rx="3" fill="#972E28" opacity="0.18"/>
      </pattern>
    </defs>
    <rect width="600" height="200" fill={`url(#brick-${seed})`}/>
  </svg>
</div>
