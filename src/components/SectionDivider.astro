---
/**
 * Brick-stack divider between homepage modules.
 * 4 rows of horizontal bricks, left-anchored to the content container,
 * descending rightward (each row shorter than the one above it). Uniform
 * strong brick color throughout — same 0.55 / 0.48 opacity alternation as
 * the old middle row, no faded edges.
 */
---

<div class="bg-bone py-4" aria-hidden="true">
  <div class="container-content">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 220 52"
      width="220"
      height="52"
      class="block"
      fill="#972E28"
    >
      <!-- Row 1 (top, 5 bricks) -->
      <rect x="0"   y="0"  width="40" height="10" rx="2" opacity="0.55"/>
      <rect x="44"  y="0"  width="40" height="10" rx="2" opacity="0.48"/>
      <rect x="88"  y="0"  width="40" height="10" rx="2" opacity="0.55"/>
      <rect x="132" y="0"  width="40" height="10" rx="2" opacity="0.48"/>
      <rect x="176" y="0"  width="40" height="10" rx="2" opacity="0.55"/>

      <!-- Row 2 (4 bricks) -->
      <rect x="0"   y="14" width="40" height="10" rx="2" opacity="0.48"/>
      <rect x="44"  y="14" width="40" height="10" rx="2" opacity="0.55"/>
      <rect x="88"  y="14" width="40" height="10" rx="2" opacity="0.48"/>
      <rect x="132" y="14" width="40" height="10" rx="2" opacity="0.55"/>

      <!-- Row 3 (3 bricks) -->
      <rect x="0"   y="28" width="40" height="10" rx="2" opacity="0.55"/>
      <rect x="44"  y="28" width="40" height="10" rx="2" opacity="0.48"/>
      <rect x="88"  y="28" width="40" height="10" rx="2" opacity="0.55"/>

      <!-- Row 4 (2 bricks) -->
      <rect x="0"   y="42" width="40" height="10" rx="2" opacity="0.48"/>
      <rect x="44"  y="42" width="40" height="10" rx="2" opacity="0.55"/>
    </svg>
  </div>
</div>
