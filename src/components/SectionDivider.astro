---
/**
 * Subtle running-bond brick pattern divider between homepage modules.
 * Middle row holds the full accent; top and bottom rows fade out.
 */
---

<div class="bg-bone py-3" aria-hidden="true">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 240 42"
    width="240"
    height="42"
    class="mx-auto block"
  >
    <!-- Row 1 (top, faded) -->
    <g fill="#972E28" opacity="0.22">
      <rect x="0"   y="0"  width="34" height="10" rx="2"/>
      <rect x="38"  y="0"  width="48" height="10" rx="2"/>
      <rect x="90"  y="0"  width="34" height="10" rx="2"/>
      <rect x="128" y="0"  width="48" height="10" rx="2"/>
      <rect x="180" y="0"  width="34" height="10" rx="2"/>
      <rect x="218" y="0"  width="22" height="10" rx="2"/>
    </g>

    <!-- Row 2 (middle, strongest) -->
    <g fill="#972E28" opacity="0.55">
      <rect x="-12" y="14" width="34" height="10" rx="2"/>
      <rect x="26"  y="14" width="34" height="10" rx="2"/>
      <rect x="64"  y="14" width="48" height="10" rx="2"/>
      <rect x="116" y="14" width="34" height="10" rx="2"/>
      <rect x="154" y="14" width="48" height="10" rx="2"/>
      <rect x="206" y="14" width="34" height="10" rx="2"/>
    </g>

    <!-- Row 3 (bottom, faded) -->
    <g fill="#972E28" opacity="0.22">
      <rect x="0"   y="28" width="48" height="10" rx="2"/>
      <rect x="52"  y="28" width="34" height="10" rx="2"/>
      <rect x="90"  y="28" width="34" height="10" rx="2"/>
      <rect x="128" y="28" width="48" height="10" rx="2"/>
      <rect x="180" y="28" width="34" height="10" rx="2"/>
      <rect x="218" y="28" width="22" height="10" rx="2"/>
    </g>
  </svg>
</div>
