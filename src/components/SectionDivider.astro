---
/**
 * Subtle brick-pattern divider between homepage modules.
 * Repeating row of 5 small "bricks" centered on the page in brick color at low opacity.
 */
---

<div class="bg-bone py-3" aria-hidden="true">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 200 16"
    width="200"
    height="16"
    class="mx-auto block"
  >
    <g fill="#972E28" opacity="0.45">
      <rect x="0"   y="2" width="32" height="12" rx="2"/>
      <rect x="38"  y="2" width="32" height="12" rx="2"/>
      <rect x="76"  y="2" width="48" height="12" rx="2"/>
      <rect x="130" y="2" width="32" height="12" rx="2"/>
      <rect x="168" y="2" width="32" height="12" rx="2"/>
    </g>
  </svg>
</div>
