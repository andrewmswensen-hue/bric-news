---
import BaseLayout from '../layouts/BaseLayout.astro';
import OhioIcon from '../components/OhioIcon.astro';
import { getCollection } from 'astro:content';

/**
 * Build-time count of distinct Columbus-metro places BRIC has touched in any
 * item (policy, news, market_data, event) or dedicated city hub. Recomputes
 * on every build, so the About stat stays truthful as content grows.
 */
const KNOWN_PLACES = [
  // 13 covered municipalities / counties (all have dedicated hubs)
  'Columbus', 'Dublin', 'Westerville', 'Grove City', 'Gahanna', 'Hilliard',
  'Reynoldsburg', 'Worthington', 'Upper Arlington', 'Bexley',
  'Franklin County', 'Delaware County', 'Licking County',
  // Other Columbus-metro places our content may reference
  'Powell', 'Whitehall', 'Grandview Heights', 'Canal Winchester', 'Granville',
  'Delaware', 'Pickerington', 'New Albany', 'Lancaster', 'Newark', 'London',
  'Marysville', 'Sunbury', 'Baltimore', 'Heath', 'Hebron', 'Buckeye Lake',
  'Plain City', 'Lewis Center', 'Franklin', 'Johnstown', 'Pataskala',
  'Groveport', 'Obetz', 'Minerva Park', 'Dublin', 'Ostrander',
] as const;

const MUNICIPALITY_TO_CITY: Record<string, string> = {
  columbus: 'Columbus',
  dublin: 'Dublin',
  westerville: 'Westerville',
  'grove-city': 'Grove City',
  gahanna: 'Gahanna',
  hilliard: 'Hilliard',
  reynoldsburg: 'Reynoldsburg',
  worthington: 'Worthington',
  'upper-arlington': 'Upper Arlington',
  bexley: 'Bexley',
  'franklin-county': 'Franklin County',
  'delaware-county': 'Delaware County',
  'licking-county': 'Licking County',
};

const [allItems, allCities] = await Promise.all([
  getCollection('items'),
  getCollection('cities'),
]);

// Haystack of every string worth searching for place references
const haystack = allItems
  .map((i) => [
    i.data.title,
    i.data.summary,
    (i.data.entities ?? []).join(' '),
    (i.data.municipalities ?? []).map((m) => MUNICIPALITY_TO_CITY[m] || '').join(' '),
  ].join(' '))
  .join(' ');

const placesCovered = new Set<string>();
// Start with every dedicated hub in the cities collection
for (const c of allCities) placesCovered.add(c.data.name);
// Plus any known place that shows up in any item's text
for (const place of KNOWN_PLACES) {
  const safe = place.replace(/[-/\\^$*+?.()|[\]{}]/g, '\\$&');
  const re = new RegExp(`\\b${safe}\\b`);
  if (re.test(haystack)) placesCovered.add(place);
}
const placesCount = placesCovered.size;
---

<BaseLayout title="About – BRIC.News" description="Editorial mission, correction policy, and takedown policy for BRIC.News.">
  <!-- Hero band with Ohio icon as visual anchor -->
  <section class="bg-bone-2 border-b border-rule">
    <div class="container-content py-14 md:py-20">
      <div class="grid md:grid-cols-3 gap-10 items-center">
        <div class="md:col-span-2">
          <p class="font-heading font-bold text-brick text-sm uppercase tracking-widest mb-3">About BRIC.News</p>
          <h1 class="font-heading font-extrabold text-3xl md:text-5xl text-charcoal leading-tight mb-4">
            A Columbus investor publication, nothing more.
          </h1>
          <p class="text-lg text-slate leading-relaxed max-w-prose">
            News, policy, a working business directory, and the resources Columbus investors actually use — reported in a neutral voice, free to read forever.
          </p>
        </div>
        <div class="flex justify-center md:justify-end">
          <OhioIcon variant="solid" size="xl" label="Central Ohio" />
        </div>
      </div>
    </div>
  </section>

  <!-- Coverage stats strip -->
  <section class="bg-bone border-b border-rule">
    <div class="container-content py-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-10 text-center md:text-left">
        <div>
          <div class="font-heading font-extrabold text-brick text-3xl md:text-4xl leading-none mb-1">{placesCount}</div>
          <div class="text-xs text-slate uppercase tracking-wider">Columbus-metro places in our coverage</div>
        </div>
        <div>
          <div class="font-heading font-extrabold text-brick text-3xl md:text-4xl leading-none mb-1">3</div>
          <div class="text-xs text-slate uppercase tracking-wider">Counties (Franklin · Delaware · Licking)</div>
        </div>
        <div>
          <div class="font-heading font-extrabold text-brick text-3xl md:text-4xl leading-none mb-1">10</div>
          <div class="text-xs text-slate uppercase tracking-wider">Business directory categories</div>
        </div>
        <div>
          <div class="font-heading font-extrabold text-brick text-3xl md:text-4xl leading-none mb-1">$0</div>
          <div class="text-xs text-slate uppercase tracking-wider">Sponsored news coverage, ever</div>
        </div>
      </div>
    </div>
  </section>

  <section class="module-band bg-bone">
    <div class="container-content max-w-prose">
      <h2 class="font-heading font-bold text-brick text-xl mt-4 mb-3">Our mission</h2>
      <p class="mb-4">
        BRIC.News exists to help Columbus-metro real estate investors and landlords get work done and stay informed. We track policy changes across Central Ohio municipalities, surface local market news, maintain a curated business directory Columbus investors use, and compile the resources you'd otherwise have to hunt down yourself.
      </p>
      <p class="mb-4">
        Our editorial standards are simple: Columbus-first framing, primary sources, specific numbers, no hype. If we don't know something, we say so. If we get something wrong, we correct it.
      </p>
      <p class="mb-4">
        We don't take sponsorship for news coverage. Business directory listings are free. Preferred designations are editorial picks based on stated criteria, not paid placements. If you think we got one wrong, tell us.
      </p>

      <h2 id="editorial" class="font-heading font-bold text-brick text-xl mt-12 mb-3">How BRIC works</h2>
      <p class="mb-4">
        BRIC is a pointer, not a republisher. Every news and policy item is a short original summary written from the facts in the source's reporting, followed by a plain "why it matters" line for Columbus investors, followed by a link to the original story. We name the publisher on every item, we open the original in a new tab, and we never reproduce a publisher's sentences or images. If a BRIC summary ever reads as a substitute for the source, we have done it wrong.
      </p>
      <p class="mb-4">
        Items are gathered daily from publisher feeds and news searches across three tiers. Local Columbus-metro coverage has the widest net. Ohio-statewide stories need a clear housing or property nexus. National stories have to change what a Columbus landlord actually does or pays before they earn a slot. We honor every publisher's robots.txt, we skip paywalled articles rather than work around them, and a publisher who asks to be excluded is excluded the same day.
      </p>
      <p class="mb-4">
        Summaries are drafted with AI assistance from the publisher's reporting and reviewed by a person before they publish. Each item records which model drafted it and when. If a summary gets a fact wrong, the correction policy below applies.
      </p>
      <p class="mb-4">
        Nothing on BRIC is legal, tax, or investment advice. We report what a rule says and who it reaches; what to do about it is between you and your own advisors.
      </p>

      <h2 id="partners" class="font-heading font-bold text-brick text-xl mt-12 mb-3">Partner content</h2>
      <p class="mb-4">
        BRIC has an editorial partnership with <a href="https://www.rlpmg.com" target="_blank" rel="noopener noreferrer">RL Property Management</a>, a Columbus-area residential property manager that is also BRIC's Preferred pick in that category. With RL's permission we adapt educational posts from its blog into BRIC items. Those items carry a visible "Partner" label, link to the original, and are kept out of the top-story slots. The partnership does not buy coverage: RL is not a news subject on BRIC unless it is genuinely in the news, and no other company's content is republished this way.
      </p>

      <h2 id="corrections" class="font-heading font-bold text-brick text-xl mt-12 mb-3">Correction policy</h2>
      <p class="mb-4">
        If you find a factual error in any item, email <a href="mailto:corrections@bric.news">corrections@bric.news</a> with the item URL and what needs to change. We review every correction request within seven days. If the correction is factually supported we make the fix and note the change at the bottom of the item.
      </p>

      <h2 id="takedown" class="font-heading font-bold text-brick text-xl mt-12 mb-3">Takedown policy</h2>
      <p class="mb-4">
        <strong>Publishers:</strong> if you would rather BRIC not summarize or link to your work, email <a href="mailto:hello@bric.news">hello@bric.news</a> from an address at your domain. We remove the items and add your site to a permanent exclusion list the same business day. No argument, no form.
      </p>
      <p class="mb-4">
        <strong>Businesses:</strong> any business can request removal from the directory at any time, for any reason. Email <a href="mailto:hello@bric.news">hello@bric.news</a> from the business email on the listing (or another verifiable channel) and we will remove the entry within seven days. This applies to every tier of listing, including Preferred designations.
      </p>

      <h2 id="contact" class="font-heading font-bold text-brick text-xl mt-12 mb-3">Contact</h2>
      <p class="mb-4">
        General inquiries, submissions, takedowns, and corrections all go to <a href="mailto:hello@bric.news">hello@bric.news</a>.
      </p>
    </div>
  </section>
</BaseLayout>
