---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ItemCard from '../../components/ItemCard.astro';
import FeatureItemCard from '../../components/FeatureItemCard.astro';
import FilterBar from '../../components/FilterBar.astro';
import OhioIcon from '../../components/OhioIcon.astro';
import { getCollection } from 'astro:content';
import { MUNICIPALITIES } from '../../content/config';

const all = await getCollection('items');
const items = all
  .filter((i) => i.data.content_type === 'policy')
  .sort((a, b) => {
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    return b.data.published_at.getTime() - a.data.published_at.getTime();
  });
const [feature, ...rest] = items;

const muniOptions = MUNICIPALITIES.map((m) => ({ value: m, label: m.replace(/-/g, ' ') }));
const statusValues = Array.from(new Set(items.map((i) => i.data.legislative_status).filter(Boolean) as string[])).sort();
const statusOptions = statusValues.map((s) => ({ value: s, label: s }));
---

<BaseLayout title="Policy Watch – BRIC.News" description="Columbus-metro real estate policy updates, curated for investors and landlords.">
  <section class="module-band bg-bone">
    <div class="container-content">
      <div class="relative mb-10">
        <div class="max-w-prose">
          <h1 class="font-heading font-extrabold text-3xl md:text-4xl text-charcoal">Columbus-Metro Policy Watch</h1>
          <p class="text-slate mt-2">Policy, permits, and regulation changes across Columbus and the surrounding municipalities. Updated as items move.</p>
        </div>
        <div class="md:absolute md:top-0 md:right-0 md:-mt-4 mt-6 flex md:block">
          <OhioIcon variant="solid" size="lg" label="Central Ohio" class="md:opacity-90" />
        </div>
      </div>

      <FilterBar
        target="[data-policy-item]"
        groups={[
          { label: 'Municipality', attr: 'muni', options: muniOptions },
          { label: 'Status', attr: 'status', options: statusOptions },
        ]}
      />

      {items.length === 0 ? (
        <p class="text-slate italic">No policy items yet.</p>
      ) : (
        <>
          {feature && (
            <div
              class="mb-8"
              data-policy-item
              data-muni={feature.data.municipalities.join(',')}
              data-status={feature.data.legislative_status || ''}
            >
              <FeatureItemCard item={feature} showPolicyBadge />
            </div>
          )}
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            {rest.map((item) => (
              <div
                data-policy-item
                data-muni={item.data.municipalities.join(',')}
                data-status={item.data.legislative_status || ''}
              >
                <ItemCard item={item} showPolicyBadge />
              </div>
            ))}
          </div>
        </>
      )}
    </div>
  </section>
</BaseLayout>
