---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VendorCard from '../../components/VendorCard.astro';
import { getCollection } from 'astro:content';
import { VENDOR_CATEGORIES } from '../../content/config';

const all = await getCollection('vendors');
const businesses = all.sort((a, b) => {
  if (a.data.preferred !== b.data.preferred) return a.data.preferred ? -1 : 1;
  return a.data.name.localeCompare(b.data.name);
});

// Only show category filter chips for categories that actually have entries.
const activeCategories = VENDOR_CATEGORIES.filter((c) =>
  businesses.some((b) => b.data.category === c),
);

const CATEGORY_LABEL: Record<string, string> = {
  'real-estate-agents':    'Real Estate',
  'property-management':   'Property Management',
  'maintenance-repair':    'Maintenance & Repair',
  'legal-compliance':      'Legal',
  'lending-finance':       'Finance',
  'insurance':             'Insurance',
  'inspection-assessment': 'Inspection',
  'turn-renovation':       'Turn & Renovation',
  'tax-accounting':        'Tax & Accounting',
  'design-staging':        'Design & Staging',
};
---

<BaseLayout title="Business Directory – BRIC.News" description="Curated directory of Columbus-metro businesses that real estate investors and landlords use across finance, legal, maintenance, insurance, and more.">
  <section class="bg-bone module-band">
    <div class="container-content">
      <div class="text-center mb-10 md:mb-14">
        <h1 class="font-heading font-extrabold text-4xl md:text-5xl tracking-tight text-charcoal uppercase">Business Directory</h1>
        <div class="mx-auto mt-4 h-[3px] w-20 bg-brick"></div>
        <p class="mt-6 mx-auto max-w-prose text-slate text-base md:text-lg">
          Local businesses Columbus-metro investors use across finance, legal, maintenance, insurance, and more. Every listing is free. Preferred designations are editorial picks based on stated criteria, not paid placements.
        </p>
      </div>

      <!-- Category filter pills -->
      <div class="flex flex-wrap justify-center gap-2 md:gap-3 mb-6" data-filter-pills>
        <button type="button" class="filter-pill filter-pill-active" data-filter-category="all" aria-pressed="true">All</button>
        {activeCategories.map((c) => (
          <button type="button" class="filter-pill" data-filter-category={c} aria-pressed="false">
            {CATEGORY_LABEL[c] || c.replace(/-/g, ' ')}
          </button>
        ))}
      </div>

      <!-- Search -->
      <div class="max-w-xl mx-auto mb-12">
        <label class="sr-only" for="directory-search">Search businesses</label>
        <div class="relative">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-4 top-1/2 -translate-y-1/2 text-slate"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input
            id="directory-search"
            type="search"
            placeholder="Search businesses..."
            class="w-full border border-rule bg-white pl-11 pr-4 py-3 rounded-sm focus:outline-none focus:border-brick text-charcoal"
            autocomplete="off"
          />
        </div>
      </div>

      <!-- Card grid -->
      <div id="directory-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
        {businesses.map((v) => (
          <div
            class="directory-item"
            data-category={v.data.category}
            data-search={`${v.data.name} ${v.data.description} ${v.data.sub_categories.join(' ')} ${v.data.category}`.toLowerCase()}
          >
            <VendorCard vendor={v} />
          </div>
        ))}
      </div>

      <p id="directory-empty" class="hidden text-center text-slate italic mt-12">No businesses match your filters yet.</p>

      <div class="mt-14 text-center text-sm text-slate">
        <p>Want to be listed? <a href="mailto:hello@bric.news?subject=Business%20submission" class="text-brick">Submit your business</a>.</p>
        <p class="mt-1">See something wrong? <a href="/about#corrections" class="text-brick">Correction policy</a> · <a href="/about#takedown" class="text-brick">Takedown policy</a></p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .filter-pill {
    @apply px-5 py-2 rounded-full border border-rule bg-bone-2 text-charcoal font-medium text-sm uppercase tracking-wider cursor-pointer transition-colors;
  }
  .filter-pill:hover {
    @apply border-brick text-brick;
  }
  .filter-pill-active {
    @apply bg-brick text-bone border-brick;
  }
  .filter-pill-active:hover {
    @apply text-bone;
  }
</style>

<script>
  const pills = document.querySelectorAll<HTMLButtonElement>('[data-filter-category]');
  const items = document.querySelectorAll<HTMLElement>('.directory-item');
  const input = document.getElementById('directory-search') as HTMLInputElement | null;
  const empty = document.getElementById('directory-empty');
  let currentCategory = 'all';
  let currentQuery = '';

  function apply() {
    let visible = 0;
    const q = currentQuery.trim().toLowerCase();
    items.forEach((el) => {
      const cat = el.dataset.category || '';
      const searchable = el.dataset.search || '';
      const catOk = currentCategory === 'all' || cat === currentCategory;
      const searchOk = q === '' || searchable.includes(q);
      const show = catOk && searchOk;
      el.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    if (empty) empty.classList.toggle('hidden', visible > 0);
  }

  pills.forEach((btn) => {
    btn.addEventListener('click', () => {
      currentCategory = btn.dataset.filterCategory!;
      pills.forEach((p) => {
        p.classList.remove('filter-pill-active');
        p.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('filter-pill-active');
      btn.setAttribute('aria-pressed', 'true');
      apply();
    });
  });

  input?.addEventListener('input', () => {
    currentQuery = input.value;
    apply();
  });
</script>
