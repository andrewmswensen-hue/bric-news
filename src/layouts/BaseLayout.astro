---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ItemDetail from '../components/ItemDetail.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = 'BRIC.News – Columbus investor news, business directory, and resources',
  description = 'Columbus investor news, business directory, and resources. Updated daily.',
  canonical,
} = Astro.props;

const site = (Astro.site?.toString() ?? 'https://bric.news/').replace(/\/$/, '');
const canonicalUrl = canonical ?? `${site}${Astro.url.pathname}`;
const ogImage = `${site}/logos/bric-logo-color-tagline.png`;

// Structured data for search engines and AI crawlers: who publishes this
// site, what it is, and where the feed lives.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'NewsMediaOrganization',
      '@id': `${site}/#organization`,
      name: 'BRIC.News',
      alternateName: 'BRIC',
      url: `${site}/`,
      logo: { '@type': 'ImageObject', url: `${site}/logos/bric-logo-color.png` },
      slogan: 'Buy. Rent. Invest. Columbus.',
      description: 'An independent Columbus, Ohio publication for real estate investors, landlords, and property managers.',
      areaServed: { '@type': 'Place', name: 'Columbus, Ohio metropolitan area' },
      email: 'hello@bric.news',
      correctionsPolicy: `${site}/about#corrections`,
      ethicsPolicy: `${site}/about#editorial`,
    },
    {
      '@type': 'WebSite',
      '@id': `${site}/#website`,
      url: `${site}/`,
      name: 'BRIC.News',
      publisher: { '@id': `${site}/#organization` },
      inLanguage: 'en-US',
    },
    {
      '@type': 'WebPage',
      '@id': canonicalUrl,
      url: canonicalUrl,
      name: title,
      description,
      isPartOf: { '@id': `${site}/#website` },
    },
  ],
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BRIC.News" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="BRIC.News" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-bone text-charcoal font-body min-h-screen flex flex-col">
    <Nav />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <ItemDetail />
  </body>
</html>
